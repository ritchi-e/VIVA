# Django
DJANGO_SECRET_KEY=dev-insecure-change-me-aiviva-32chars!!
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:13000,http://localhost:3000
# Production also needs (see .env.production.example):
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mokhik.online,https://www.mokhik.online

# Database
POSTGRES_DB=aiviva
POSTGRES_USER=aiviva
POSTGRES_PASSWORD=aiviva
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CHANNELS_REDIS_URL=redis://redis:6379/3

# MinIO / S3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=aiviva
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1

# AI Provider: mock | openai | gemini
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Faster model for live viva question turns (optional; defaults to OPENAI_CHAT_MODEL)
OPENAI_VIVA_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
# Rumik silk TTS (Mulberry) — preferred for examiner voice when set
# https://docs.rumik.ai/mulberry
RUMIK_API_KEY=
TTS_PROVIDER=auto
RUMIK_TTS_MODEL=mulberry
RUMIK_TTS_DEFAULT_SPEAKER=siya
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Deepgram Nova-3 STT (student answers). Keyterms from the submission are prompted server-side.
# Accepts DEEPGRAM_API_KEY or deepgram_nova3_api
DEEPGRAM_API_KEY=
# deepgram_nova3_api=
STT_PROVIDER=auto
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_TIMEOUT=45

# Google OAuth (optional) — same client ID on backend and frontend
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Frontend (browser talks to host-mapped backend port)
VITE_API_URL=http://localhost:18000/api
VITE_WS_URL=ws://localhost:18000/ws

# GitHub static ingestion (public repositories only)
GITHUB_STATIC_INGESTION_ENABLED=true
GITHUB_API_TOKEN=
MAX_SUBMISSION_FILE_BYTES=26214400
MAX_REPO_ARCHIVE_BYTES=41943040
MAX_REPO_FILES=400
MAX_REPO_FILE_BYTES=409600
MAX_EXTRACTED_CHARS=400000
REPO_FETCH_TIMEOUT_SEC=45
