# Copy to .env.local (gitignored). Loaded after .env and overrides Docker service hostnames
# for running backend and Celery directly on your machine.
#
#   cp .env.local.example .env.local
#
# Keep .env for shared secrets (API keys). Use .env.local only for local host overrides.

POSTGRES_HOST=localhost
POSTGRES_PORT=15432

REDIS_URL=redis://localhost:16379/0
CELERY_BROKER_URL=redis://localhost:16379/1
CELERY_RESULT_BACKEND=redis://localhost:16379/2
CHANNELS_REDIS_URL=redis://localhost:16379/3

AWS_S3_ENDPOINT_URL=http://localhost:19000

# Vite dev server (frontend/.env.local also sets VITE_* — see frontend/.env.local.example)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:13000,http://localhost:3000
