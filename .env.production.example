# Copy to .env on the Linode host and fill in real values.
#   cp .env.production.example .env

DOMAIN=mokhik.online

# Django — generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=mokhik.online,www.mokhik.online
DJANGO_CORS_ALLOWED_ORIGINS=https://mokhik.online,https://www.mokhik.online
DJANGO_CSRF_TRUSTED_ORIGINS=https://mokhik.online,https://www.mokhik.online

# Database — use a strong unique password
POSTGRES_DB=aiviva
POSTGRES_USER=aiviva
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (internal Docker network — leave as-is)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CHANNELS_REDIS_URL=redis://redis:6379/3

# MinIO (internal only — change from minioadmin defaults)
AWS_ACCESS_KEY_ID=REPLACE_MINIO_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_MINIO_SECRET_KEY
AWS_STORAGE_BUCKET_NAME=aiviva
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1

# AI / voice providers
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VIVA_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

RUMIK_API_KEY=
TTS_PROVIDER=rumik
RUMIK_TTS_MODEL=mulberry
RUMIK_TTS_DEFAULT_SPEAKER=siya

DEEPGRAM_API_KEY=
STT_PROVIDER=deepgram
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_TIMEOUT=45

# Google OAuth — add https://mokhik.online as an Authorized JavaScript origin
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Baked into the SPA at image build time (same-origin via Caddy)
VITE_API_URL=https://mokhik.online/api
VITE_WS_URL=wss://mokhik.online/ws

# Optional
GITHUB_STATIC_INGESTION_ENABLED=true
GITHUB_API_TOKEN=
DEFAULT_FROM_EMAIL=noreply@mokhik.online
